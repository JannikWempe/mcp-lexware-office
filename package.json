{
  "name": "mcp-lexware-office",
  "description": "MCP server to interact with Lexware Office",
  "version": "3.0.1",
  "license": "MIT",
  "author": "Jannik Wempe <jannik@wempe.dev>",
  "contributors": [
    "Simon Fieber <https://github.com/si0nDE>"
  ],
  "keywords": [
    "mcp",
    "lexware-office",
    "lexoffice"
  ],
  "homepage": "https://github.com/JannikWempe/mcp-lexware-office",
  "bugs": "https://github.com/JannikWempe/mcp-lexware-office/issues",
  "type": "module",
  "bin": {
    "lexware-office": "./build/index.js",
    "lexware-office-v2": "./build/cli-v2.js"
  },
  "files": [
    "build",
    "docs"
  ],
  "scripts": {
    "build": "shx rm -rf build && tsc && shx chmod +x build/*.js",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test build/*.test.js",
    "check:docs": "npm run build && node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "quickjs-emscripten": "0.32.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "shx": "^0.4.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0"
}
